# ---------------------------------------------------------------------------
# CHAKRAVYUH configuration. Copy to .env and edit, or just export what you need.
#
# NO API KEY IS NEEDED FOR ANY OF THIS:
#   scripts/build_kb.py      clause store, chunks, KB report
#   scripts/run_demo.py      baseline + cross-pack comparison + gap register
#   scripts/run_fuzz.py      Hypothesis campaign, failure cards
#   scripts/eval_retrieval.py / eval_adviser.py / gen_y3172_map.py / verify_ledger.py
#   streamlit run app/streamlit_app.py
#   pytest
# The rule-based agent twins, the policy engine, properties, gap classification and the
# extractive Adviser are all deterministic code. Keys matter only for the LLM agent tier
# and the generative Adviser, and only in `record` or `live` mode.
# ---------------------------------------------------------------------------

# ---- Record / replay. This is what makes "replay from seed" true. ----
# replay (default) : read cache/<sha>.json; a miss raises CacheMiss. NEEDS NO PROVIDER, NO KEY.
# record           : call the provider and persist the answer. Needs a reachable model.
# live             : call the provider, persist nothing. Development only.
CHAKRAVYUH_LLM_MODE=replay
CHAKRAVYUH_LLM_CACHE=cache

# ---- Local model: the ITU Sandbox reference stack. NO API KEY. ----
# Needs Ollama running and the models pulled:
#   ollama pull qwen2.5:14b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
CHAKRAVYUH_LOCAL_MODEL=ollama/qwen2.5:14b
CHAKRAVYUH_EMBED_MODEL=ollama/nomic-embed-text

# ---- Hosted model: used for the showcase run only (spec §3). ----
# Selected by `--hosted` on run_demo.py / eval_adviser.py, or by --model <id>.
# Uncomment ONE of these pairs. The key name is checked before a record run starts, so a
# missing one fails in a second with the variable named rather than mid-recording.
CHAKRAVYUH_HOSTED_MODEL=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# CHAKRAVYUH_HOSTED_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...
#
# CHAKRAVYUH_HOSTED_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=...
#
# The adviser eval's LLM judge must be a DIFFERENT model from the adviser:
#   python scripts/eval_adviser.py --use-llm --hosted --judge-model openai/gpt-4o

# ---- ITU reference vector KB (ChromaDB). Optional; BM25 fallback if absent. ----
# Embeddings use CHAKRAVYUH_EMBED_MODEL via Ollama when reachable (no key), otherwise
# Chroma's own local embedder. Either way: no API key.
CHROMA_PATH=data/chroma

# ---- Optional reranker (spec P2, only if recall@5 < 0.8). Local model, no API key. ----
# Needs `pip install sentence-transformers`; downloads weights on first use.
CHAKRAVYUH_RERANKER=BAAI/bge-reranker-base
